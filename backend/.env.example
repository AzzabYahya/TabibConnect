NODE_ENV=development
PORT=4000
APP_BASE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173,http://localhost:5174
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/tabibconnect
REDIS_URL=redis://localhost:6379

# JWT + Password hashing
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12
FRONTEND_URL=http://localhost:5173
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxxxxxx
STRIPE_CURRENCY=mad
REFRESH_TOKEN_COOKIE_NAME=tabibconnect_refresh_token

# Auth rate limiting (5 attempts / 15 min)
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=5

# CSRF
CSRF_SECRET=change_me_csrf_secret
CSRF_COOKIE_NAME=tabibconnect_csrf_token
CSRF_HEADER_NAME=x-csrf-token

# Verification + password reset
EMAIL_VERIFY_TOKEN_EXPIRES_MINUTES=1440
RESET_PASSWORD_TOKEN_EXPIRES_MINUTES=30

# Document upload (doctor registration)
UPLOAD_DOCUMENTS_DIR=uploads/documents

# SMTP (optional for real email delivery)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TabibConnect <no-reply@tabibconnect.ma>

# Twilio SMS (optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Appointment policy (Etape 5)
FREE_CANCELLATION_HOURS=2
REMINDER_HOURS_BEFORE=24
REMINDER_WINDOW_MINUTES=10
NO_SHOW_GRACE_MINUTES=30
