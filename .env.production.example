NODE_ENV=production
DOMAIN=tabibconnect.ma
LETSENCRYPT_EMAIL=admin@tabibconnect.ma

POSTGRES_DB=tabibconnect
POSTGRES_USER=tabibconnect
POSTGRES_PASSWORD=change_me_postgres_password

DATABASE_URL=postgresql://tabibconnect:change_me_postgres_password@postgres:5432/tabibconnect
APP_BASE_URL=https://tabibconnect.ma
FRONTEND_URL=https://tabibconnect.ma
CORS_ORIGIN=https://tabibconnect.ma
PORT=4000

JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
BCRYPT_SALT_ROUNDS=12

CSRF_SECRET=change_me_csrf_secret
CSRF_COOKIE_NAME=tabibconnect_csrf_token
CSRF_HEADER_NAME=x-csrf-token
REFRESH_TOKEN_COOKIE_NAME=tabibconnect_refresh_token

EMAIL_VERIFY_TOKEN_EXPIRES_MINUTES=1440
RESET_PASSWORD_TOKEN_EXPIRES_MINUTES=30
UPLOAD_DOCUMENTS_DIR=uploads/documents

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=TabibConnect <no-reply@tabibconnect.ma>

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

FREE_CANCELLATION_HOURS=2
REMINDER_HOURS_BEFORE=24
REMINDER_WINDOW_MINUTES=10
NO_SHOW_GRACE_MINUTES=30

REDIS_URL=redis://redis:6379
VITE_API_URL=https://tabibconnect.ma/api